# Docker Compose environment for NGIS Stream. Copy this file to .env before the
# first run and adjust the values.
#
#   HTTP_PORT, HTTPS_PORT  Host ports published by the reverse proxy (443 is
#                          published on both TCP and UDP for HTTP/3).
#   COMPOSE_PROFILES       Reverse proxy to run: openlitespeed (LSQUIC) or
#                          caddy (quic-go). Changed by scripts/switch-proxy.sh.
#   HOST, PORT             Bind address of the backend API inside the proxy
#                          network namespace.
#   DOMAIN                 Host name served by the proxy and written into the
#                          TLS certificate.
#   CORS_ORIGIN            Origins allowed to call the backend API, comma
#                          separated, or * for any origin.

HTTP_PORT=80
HTTPS_PORT=443

COMPOSE_PROFILES=openlitespeed

HOST=0.0.0.0
PORT=3000

DOMAIN=localhost
CORS_ORIGIN=https://localhost
