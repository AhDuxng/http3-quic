HTTP_PORT=80
HTTPS_PORT=443

# Proxy dang dung: openlitespeed, caddy hoac custom
COMPOSE_PROFILES=openlitespeed

# Custom server: h2, quic hoac mpquic
CUSTOM_MODE=mpquic
CUSTOM_SCHEDULER=default
CUSTOM_ADVERTISE_H3=true
RUN_ID=

HOST=0.0.0.0
PORT=3000

DOMAIN=localhost
CORS_ORIGIN=https://localhost
