# Files and directories that must never be committed: dependencies, build
# output, local environment files, logs, editor files, generated TLS material,
# DASH video datasets and experiment captures.

node_modules/
backend/node_modules/
frontend/node_modules/

/package.json
/package-lock.json

frontend/dist/
frontend/dist-ssr/
backend/dist/
coverage/

.env
.env.*
!.env.example
*.local

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

*.pid
*.pid.lock
*.seed
.cache/
.tmp/
tmp/

openlitespeed_config/certs/*
