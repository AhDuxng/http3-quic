+static void custom_h3_access_log(picoquic_cnx_t* cnx, h3zero_stream_ctx_t* stream_ctx)
+{
+	const char* log_file = getenv("CUSTOM_H3_ACCESS_LOG");
+	const uint8_t* request_path = stream_ctx->ps.stream_state.header.path;
+	size_t request_path_length = stream_ctx->ps.stream_state.header.path_length;
+	for (size_t i = 0; i < request_path_length; i++) {
+		if (request_path[i] == '?') {
+			request_path_length = i;
+			break;
+		}
+	}
+	if (log_file == NULL || request_path == NULL || request_path_length < 7 ||
+		memcmp(request_path, "/video/", 7) != 0) {
+		return;
+	}
+
+	FILE* log = picoquic_file_open(log_file, "a");
+	if (log == NULL) {
+		return;
+	}
+
+	uint64_t now = picoquic_get_quic_time(cnx->quic);
+	time_t epoch_seconds;
+	uint64_t wall_milliseconds = 0;
+	struct tm utc_time;
+	char timestamp[32];
+	const char* mode = getenv("CUSTOM_MODE");
+	const char* run_id = getenv("RUN_ID");
+	const char* scheduler = (mode != NULL && strcmp(mode, "mpquic") == 0) ?
+		"picoquic-default" : "single-path";
+	const char* protocol = (mode != NULL && strcmp(mode, "mpquic") == 0) ?
+		"mpquic" : "h3";
+	const uint8_t* segment = request_path;
+	size_t segment_length = request_path_length;
+
+	for (size_t i = 0; i < request_path_length; i++) {
+		if (request_path[i] == '/') {
+			segment = request_path + i + 1;
+			segment_length = request_path_length - i - 1;
+		}
+	}
+
+#ifdef _WINDOWS
+	epoch_seconds = time(NULL);
+	gmtime_s(&utc_time, &epoch_seconds);
+#else
+	struct timeval wall_time;
+	gettimeofday(&wall_time, NULL);
+	epoch_seconds = wall_time.tv_sec;
+	wall_milliseconds = (uint64_t)wall_time.tv_usec / 1000;
+	gmtime_r(&epoch_seconds, &utc_time);
+#endif
+	strftime(timestamp, sizeof(timestamp), "%Y-%m-%dT%H:%M:%S", &utc_time);
+	for (int i = 0; i < cnx->nb_paths; i++) {
+		picoquic_path_quality_t quality = { 0 };
+		uint64_t path_id = cnx->path[i]->unique_path_id;
+		if (picoquic_get_path_quality(cnx, path_id, &quality) != 0) {
+			continue;
+		}
+		fprintf(log,
+			"{\"timestamp_utc\":\"%s.%03" PRIu64 "Z\",\"protocol\":\"%s\","
+			"\"run_id\":\"%s\",\"segment\":\"%.*s\",\"request_path\":\"%.*s\","
+			"\"download_time_ms\":%.3f,\"bytes\":%" PRIu64 ",\"rtt_ms\":%.3f,"
+			"\"loss\":%" PRIu64 ",\"cwnd_bytes\":%" PRIu64 ",\"path_id\":%" PRIu64 ","
+			"\"scheduler\":\"%s\",\"path_bytes_sent_cumulative\":%" PRIu64 ","
+			"\"metric_scope\":\"server-response-with-path-snapshot\"}\n",
+			timestamp, wall_milliseconds, protocol, (run_id == NULL) ? "" : run_id,
+			(int)segment_length, segment, (int)request_path_length, request_path,
+			(stream_ctx->response_start_time == 0) ? 0.0 :
+				(double)(now - stream_ctx->response_start_time) / 1000.0,
+			stream_ctx->echo_length, (double)quality.rtt / 1000.0, quality.lost,
+			quality.cwin, path_id, scheduler, quality.bytes_sent);
+	}
+	picoquic_file_close(log);
+}
