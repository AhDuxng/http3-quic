+static int custom_parse_byte_range(const uint8_t* value, size_t value_length,
+	uint64_t complete_length, uint64_t* range_start, uint64_t* range_end)
+{
+	char text[128];
+	char* dash;
+	char* endptr;
+	unsigned long long first;
+	unsigned long long last;
+
+	if (value == NULL || value_length == 0) {
+		*range_start = 0;
+		*range_end = complete_length == 0 ? 0 : complete_length - 1;
+		return 0;
+	}
+	if (value_length >= sizeof(text) || complete_length == 0) {
+		return -1;
+	}
+	memcpy(text, value, value_length);
+	text[value_length] = 0;
+	if (strncmp(text, "bytes=", 6) != 0 || strchr(text + 6, ',') != NULL) {
+		return -1;
+	}
+	dash = strchr(text + 6, '-');
+	if (dash == NULL || strchr(dash + 1, '-') != NULL) {
+		return -1;
+	}
+	*dash = 0;
+	if (text[6] == 0) {
+		last = strtoull(dash + 1, &endptr, 10);
+		if (*endptr != 0 || last == 0) {
+			return -1;
+		}
+		*range_start = last >= complete_length ? 0 : complete_length - last;
+		*range_end = complete_length - 1;
+		return 1;
+	}
+	first = strtoull(text + 6, &endptr, 10);
+	if (*endptr != 0 || first >= complete_length) {
+		return -1;
+	}
+	if (dash[1] == 0) {
+		last = complete_length - 1;
+	}
+	else {
+		last = strtoull(dash + 1, &endptr, 10);
+		if (*endptr != 0 || last < first) {
+			return -1;
+		}
+		if (last >= complete_length) {
+			last = complete_length - 1;
+		}
+	}
+	*range_start = first;
+	*range_end = last;
+	return 1;
+}
